# development or production
APP_ENV=production

# Required. The backend refuses to start without it.
JWT_SECRET_KEY=change-me
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Login accounts created by `make seed`
INITIAL_ADMIN_USERNAME=admin
INITIAL_ADMIN_EMAIL=admin@example.com
INITIAL_ADMIN_PASSWORD=change-me
VIEWER_USER_PASSWORD=change-me

# Birthday emails
MAIL_SERVER=smtp.example.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=your_email_username@example.com
MAIL_PASSWORD=your_email_password
MAIL_DEFAULT_SENDER="Family Tree <noreply@example.com>"

# Only for the one-off import from the old Google Sheet (python -m scripts.data_utils)
GOOGLE_SERVICE_ACCOUNT_FILE=service-account.json
GOOGLE_SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_SHEET_NAME=family_members

# Only for local dev when the frontend runs on another origin
# CORS_ORIGIN=http://localhost:5173

# Docker build args (container user); match the owner of db_data/ and logs/
UID=1000
GID=1000

# Deploy target (send_to_prod.sh; CI reads the same names from repo secrets)
VPS_HOST=example.com
VPS_PORT=22
VPS_USER=deploy
