# Serves the built SPA and proxies /api to the backend. Plain HTTP on :80:
# TLS and the public hostname are handled by the host Caddy in front of it
# (see README, "Deploy notes").
:80 {
	encode gzip

	handle /api/* {
		reverse_proxy http://backend:8000
	}

	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}

	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
	}
}
